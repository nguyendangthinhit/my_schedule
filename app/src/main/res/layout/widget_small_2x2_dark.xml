<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_calendar_header" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_small_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Thứ Hai, 25/08/2026"
                android:textColor="@color/widget_text_primary_dark"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_small_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="☀️ 32°C • Nắng"
                android:textColor="@color/widget_text_secondary_dark"
                android:textSize="9.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_small_add"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_circle_add_btn_dark"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <!-- Thẻ Tiếp theo -->
    <LinearLayout
        android:id="@+id/layout_small_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_next_card_bg_dark"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiếp theo"
            android:textColor="@color/widget_primary_dark_theme"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_small_next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Học tiếng Anh"
            android:textColor="@color/widget_text_primary_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/ic_widget_clock" />

            <TextView
                android:id="@+id/tv_small_next_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="08:40 - 10:30"
                android:textColor="@color/widget_text_secondary_dark"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tv_small_next_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_category_chip_bg_dark"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="Học tập"
                android:textColor="@color/widget_badge_study_text_dark"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_small_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Không có việc 🎉"
        android:textColor="@color/widget_text_secondary_dark"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Danh sách 2 việc gọn -->
    <LinearLayout
        android:id="@+id/layout_small_tasks_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Task 1 -->
        <LinearLayout
            android:id="@+id/layout_small_task_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_small_check_1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_check_square_empty_dark" />

            <TextView
                android:id="@+id/tv_small_task_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Học tiếng Anh"
                android:textColor="@color/widget_text_primary_dark"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/iv_small_dot_1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_dot_green" />
        </LinearLayout>

        <!-- Task 2 -->
        <LinearLayout
            android:id="@+id/layout_small_task_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_small_check_2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_check_square_empty_dark" />

            <TextView
                android:id="@+id/tv_small_task_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ăn cơm"
                android:textColor="@color/widget_text_primary_dark"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/iv_small_dot_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_dot_blue" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer: 0/2 | Xem tất cả › -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_small_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0/2"
            android:textColor="@color/widget_primary_dark_theme"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_small_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="Xem tất cả ›"
            android:textColor="@color/widget_primary_dark_theme"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
