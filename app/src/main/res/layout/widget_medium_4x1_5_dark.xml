<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header: Date, Weather, Add Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_calendar_header" />

        <TextView
            android:id="@+id/tv_medium_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Thứ Hai, 25/08/2026"
            android:textColor="@color/widget_text_primary_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_medium_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_weather_pill_bg_dark"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="☀️ 32°C • Nắng"
            android:textColor="@color/widget_text_secondary_dark"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_medium_add"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_circle_add_btn_dark"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <!-- Scrollable Task List: 1 công việc trước đó gần nhất + các công việc còn lại trong ngày -->
    <ScrollView
        android:id="@+id/scroll_medium_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/layout_medium_tasks_scroll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_medium_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:text="Không có công việc nào hôm nay 🎉"
                android:textColor="@color/widget_text_secondary_dark"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Task 1 -->
            <LinearLayout
                android:id="@+id/layout_medium_task_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4.5dp">

                <ImageView
                    android:id="@+id/iv_medium_check_1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_widget_check_square_empty_dark" />

                <TextView
                    android:id="@+id/tv_medium_badge_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/widget_category_chip_bg_dark"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="Vừa qua"
                    android:textColor="@color/widget_badge_study_text_dark"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_medium_task_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Học tiếng Anh"
                    android:textColor="@color/widget_text_primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_medium_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="08:40 - 10:30"
                    android:textColor="@color/widget_text_secondary_dark"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/iv_medium_dot_1"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:src="@drawable/widget_dot_green" />
            </LinearLayout>

            <!-- Task 2 -->
            <LinearLayout
                android:id="@+id/layout_medium_task_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4.5dp">

                <ImageView
                    android:id="@+id/iv_medium_check_2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_widget_check_square_empty_dark" />

                <TextView
                    android:id="@+id/tv_medium_badge_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/widget_category_chip_bg_dark"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="Tiếp theo"
                    android:textColor="@color/widget_badge_study_text_dark"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_medium_task_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Ăn cơm trưa"
                    android:textColor="@color/widget_text_primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_medium_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="11:30 - 12:30"
                    android:textColor="@color/widget_text_secondary_dark"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/iv_medium_dot_2"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:src="@drawable/widget_dot_blue" />
            </LinearLayout>

            <!-- Task 3 -->
            <LinearLayout
                android:id="@+id/layout_medium_task_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4.5dp">

                <ImageView
                    android:id="@+id/iv_medium_check_3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_widget_check_square_empty_dark" />

                <TextView
                    android:id="@+id/tv_medium_badge_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/widget_category_chip_bg_dark"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="Sắp tới"
                    android:textColor="@color/widget_badge_study_text_dark"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_medium_task_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Ôn thi Đại số"
                    android:textColor="@color/widget_text_primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_medium_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="14:00 - 16:00"
                    android:textColor="@color/widget_text_secondary_dark"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/iv_medium_dot_3"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:src="@drawable/widget_dot_red" />
            </LinearLayout>

            <!-- Task 4 -->
            <LinearLayout
                android:id="@+id/layout_medium_task_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4.5dp">

                <ImageView
                    android:id="@+id/iv_medium_check_4"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_widget_check_square_empty_dark" />

                <TextView
                    android:id="@+id/tv_medium_badge_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/widget_category_chip_bg_dark"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="Sắp tới"
                    android:textColor="@color/widget_badge_study_text_dark"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_medium_task_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tập Gym"
                    android:textColor="@color/widget_text_primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_medium_time_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="17:00 - 18:30"
                    android:textColor="@color/widget_text_secondary_dark"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/iv_medium_dot_4"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:src="@drawable/widget_dot_orange" />
            </LinearLayout>

            <!-- Task 5 -->
            <LinearLayout
                android:id="@+id/layout_medium_task_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4.5dp">

                <ImageView
                    android:id="@+id/iv_medium_check_5"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_widget_check_square_empty_dark" />

                <TextView
                    android:id="@+id/tv_medium_badge_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/widget_category_chip_bg_dark"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="Sắp tới"
                    android:textColor="@color/widget_badge_study_text_dark"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_medium_task_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Đọc sách"
                    android:textColor="@color/widget_text_primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_medium_time_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="20:00 - 21:00"
                    android:textColor="@color/widget_text_secondary_dark"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/iv_medium_dot_5"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:src="@drawable/widget_dot_purple" />
            </LinearLayout>

            <!-- Task 6 -->
            <LinearLayout
                android:id="@+id/layout_medium_task_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4.5dp">

                <ImageView
                    android:id="@+id/iv_medium_check_6"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_widget_check_square_empty_dark" />

                <TextView
                    android:id="@+id/tv_medium_badge_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/widget_category_chip_bg_dark"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="Sắp tới"
                    android:textColor="@color/widget_badge_study_text_dark"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_medium_task_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Viết nhật ký"
                    android:textColor="@color/widget_text_primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_medium_time_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="21:30 - 22:00"
                    android:textColor="@color/widget_text_secondary_dark"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/iv_medium_dot_6"
                    android:layout_width="6.5dp"
                    android:layout_height="6.5dp"
                    android:src="@drawable/widget_dot_green" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Footer: Progress summary and View all button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_medium_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0/2 đã hoàn thành"
            android:textColor="@color/widget_text_secondary_dark"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_medium_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="Xem tất cả ›"
            android:textColor="@color/widget_primary_dark_theme"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
